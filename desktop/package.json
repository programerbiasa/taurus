{
  "name": "taurus-desktop",
  "version": "1.0.0",
  "description": "Aplikasi Desktop TAURUS IT Support Management System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.taurus.itsupport.desktop",
    "productName": "TAURUS IT Support",
    "copyright": "Copyright © 2024 TAURUS IT Team",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TAURUS IT Support"
    }
  },
  "devDependencies": {
    "electron": "^29.2.0",
    "electron-builder": "^24.13.3"
  }
}
